<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <property>
    <name>fs.defaultFS</name>
    <value>hdfs://namenode:8020</value>
  </property>
  <property>
    <name>hive.metastore.warehouse.dir</name>
    <value>hdfs://namenode:8020/user/hive/warehouse</value>
  </property>
  <property>
    <name>hive.server2.enable.doAs</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.security.authorization.enabled</name>
    <value>false</value>
  </property>
  <!-- 关闭通知事件 API 的 proxy 鉴权，否则 NOSASL/doAs=false 下 HiveServer2 启动时
       调用 get_current_notificationEventId 会被 metastore 拒绝（User hive is not allowed），
       导致 HiveServer2 反复重试、永远起不来 -->
  <property>
    <name>hive.metastore.event.db.notification.api.auth</name>
    <value>false</value>
  </property>
  <property>
    <name>hive.execution.engine</name>
    <value>tez</value>
  </property>
  <property>
    <name>tez.local.mode</name>
    <value>true</value>
  </property>
  <property>
    <name>tez.local.mode.without.network</name>
    <value>true</value>
  </property>
  <property>
    <name>hive.exec.scratchdir</name>
    <value>file:///tmp/hive-scratch</value>
  </property>
</configuration>
