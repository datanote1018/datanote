# ============================================================
# DataNote 部署配置
# 两个安装脚本共享此文件，修改后重新运行脚本即可生效
# ============================================================

# ---------- MySQL ----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# MySQL 口令：首次部署请自行填写
MYSQL_PASSWORD=

# ---------- Hive ----------
HIVE_PORT=10800

# ---------- HDFS ----------
HDFS_WEB_PORT=9870

# ---------- DataNote ----------
DATANOTE_PORT=8099

# ---------- DataX ----------
# local=本地执行  docker=Docker容器执行
DATAX_MODE=docker

# ---------- 加密密钥（16/24/32 字节）----------
# 加密密钥：必须自行生成，切勿使用固定值，也不要提交到仓库
# 生成方法：LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; echo
CRYPTO_KEY=

# ---------- Docker 网络 ----------
NETWORK=datanote-net
