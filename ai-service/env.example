# ============================================================
# AI 服务配置 —— 复制本文件为 .env 后填入自己的值
#     cp .env.example .env
# .env 已被 .gitignore 排除，不会提交到仓库
# ============================================================

# 千问（通义/百炼）API Key —— 必填
# 申请地址：https://bailian.console.aliyun.com/  →  API-KEY 管理
QWEN_API_KEY=

# 数据库连接（可选，不填则用下面的默认值）
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=root
